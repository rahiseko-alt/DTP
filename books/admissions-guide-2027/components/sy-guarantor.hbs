{{!-- 様式3 保証人の表 --}}
  <div class="tbl tbl--tag">
    <div class="tag">保証人</div>
    <div>
      <div class="r r--hf r--6"><div class="lab lab--s">ふりがな</div><div class="c c--kana">{{#if sample}}<span class="hw hw--s">ミホン　タロウ</span>{{/if}}</div><div class="lab lab--s">本人との続柄</div></div>
      <div class="r r--hf r--14"><div class="lab">氏　名</div><div class="c seal">{{#if sample}}<span class="hw" style="margin-right:auto">見本　太郎</span>{{/if}}（印）</div><div class="c">{{#if sample}}<span class="hw hw--s">父</span>{{/if}}</div></div>
      <div class="r r--addr"><div class="lab">住所<br>電話番号</div><div class="c c--addr2"><span>〒（{{#if sample}}<span class="hw hw--s">000－0000</span>{{else}}　　　　　　－　　　　　　{{/if}}）{{#if sample}}<span class="hw hw--s" style="margin-left:3mm">愛知県○○市△△町1丁目2番3号</span>{{/if}}</span><span class="tel">TEL　{{#if sample}}<span class="hw hw--s">000-0000-0000</span>{{else}}　　　　　　（　　　　）{{/if}}</span></div></div>
    </div>
  </div>
