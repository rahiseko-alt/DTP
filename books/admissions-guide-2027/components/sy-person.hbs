{{!-- 様式3 受験者本人の表 --}}
  <div class="tbl tbl--tag">
    <div class="tag">受験者本人</div>
    <div>
      <div class="r r--6"><div class="lab lab--s">ふりがな</div><div class="c c--kana">{{#if sample}}<span class="hw hw--s">ミホン　ハナコ</span>{{/if}}</div></div>
      <div class="r r--14"><div class="lab">氏　名</div><div class="c seal">{{#if sample}}<span class="hw" style="margin-right:auto">見本　花子</span>{{/if}}（印）</div></div>
      <div class="r r--9"><div class="lab">生年月日</div><div class="c c--birth">（西暦）<i class="gap g2">{{#if sample}}<span class="hw hw--s">2000</span>{{/if}}</i>年<i class="gap g0">{{#if sample}}<span class="hw hw--s">4</span>{{/if}}</i>月<i class="gap g0">{{#if sample}}<span class="hw hw--s">1</span>{{/if}}</i>日生</div></div>
      <div class="r r--addr"><div class="lab">住所<br>電話番号</div><div class="c c--addr2"><span>〒（{{#if sample}}<span class="hw hw--s">000－0000</span>{{else}}　　　　　　－　　　　　　{{/if}}）{{#if sample}}<span class="hw hw--s" style="margin-left:3mm">愛知県○○市△△町1丁目2番3号</span>{{/if}}</span><span class="tel">TEL　{{#if sample}}<span class="hw hw--s">000-0000-0000</span>{{else}}　　　　　　（　　　　）{{/if}}</span></div></div>
    </div>
  </div>
