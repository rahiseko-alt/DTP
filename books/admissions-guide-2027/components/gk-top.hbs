{{!-- 様式1 上段（出願種別〜E-Mail） --}}
      <div class="top">
        <div class="top__main">
          <div class="r r--9"><div class="lab">出願種別</div><div class="c c--opts"><span class="cb{{#if sample}} cb--on{{/if}}"></span>{{facts.admissions.exam_types.0.name}}<span class="cb"></span>推薦<span class="cb"></span>一般</div></div>
          <div class="r r--9"><div class="lab">志望学科</div><div class="c c--opts">{{#each facts.courses.courses}}<span class="cb{{#if ../sample}}{{#if @first}} cb--on{{/if}}{{/if}}"></span>{{name}}{{/each}}</div></div>
          <div class="r r--6"><div class="lab lab--s">ふりがな</div><div class="c c--kana">{{#if sample}}<span class="hw hw--s">ミホン　ハナコ</span>{{/if}}</div></div>
          <div class="r r--21 r--sex"><div class="lab">氏　名</div><div class="c">{{#if sample}}<span class="hw">見本　花子</span>{{/if}}</div><div class="c c--sex"><span><i class="cb"></i>男</span><span><i class="cb{{#if sample}} cb--on{{/if}}"></i>女</span></div></div>
        </div>
        <div class="photo"><div class="photo__t"><b>写真貼付欄</b><span>上半身・脱帽</span><span>縦4cm×横3cm</span><span>写真の裏に氏名を記入し貼付</span></div><i></i></div>
      </div>

      <div class="r r--9"><div class="lab">生年月日</div><div class="c c--birth">昭和・{{#if sample}}<span class="cir">平成</span>{{else}}平成{{/if}}・令和<i class="gap g1">{{#if sample}}<span class="hw hw--s">12</span>{{/if}}</i>年（西暦<i class="gap g2">{{#if sample}}<span class="hw hw--s">2000</span>{{/if}}</i>年）<i class="gap g0">{{#if sample}}<span class="hw hw--s">4</span>{{/if}}</i>月<i class="gap g0">{{#if sample}}<span class="hw hw--s">1</span>{{/if}}</i>日生（満<i class="gap g0">{{#if sample}}<span class="hw hw--s">26</span>{{/if}}</i>才）</div></div>
      <div class="r r--14"><div class="lab">現住所</div><div class="c c--addr">〒（{{#if sample}}<span class="hw hw--s">000－0000</span>{{else}}　　　　　　－　　　　　　{{/if}}）{{#if sample}}<span class="hw hw--s" style="margin-left:3mm">愛知県○○市△△町1丁目2番3号</span>{{/if}}</div></div>
      <div class="r r--9 r--tel"><div class="lab">電話番号</div><div class="c">{{#if sample}}<span class="hw hw--s">000-0000-0000</span>{{/if}}</div><div class="lab">携帯電話</div><div class="c">{{#if sample}}<span class="hw hw--s">090-0000-0000</span>{{/if}}</div></div>
      <div class="r r--9"><div class="lab">E-Mail</div><div class="c">{{#if sample}}<span class="hw hw--s">sample@example.com</span>{{/if}}</div></div>

